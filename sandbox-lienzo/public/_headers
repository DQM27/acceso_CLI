# Sandbox del lienzo: sin red, sin marcos, sólo se deja mostrar dentro del panel.
# - 'unsafe-eval' y worker-src blob: son para correr el código del asistente en
#   un Web Worker armado en memoria (sin red y con tiempo límite).
# - Access-Control-Allow-Origin: el panel abre esto en un iframe con origen
#   anónimo, que pide los módulos en modo CORS. Son archivos públicos sin datos.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; worker-src blob:; style-src 'self' 'unsafe-inline'; img-src data:; font-src 'none'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors https://panel.megabrisas.com http://127.0.0.1:5173 http://localhost:5173
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), clipboard-read=(), clipboard-write=()
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache
