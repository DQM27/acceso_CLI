<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="DQM27.ControldeAccesoBrisas"
    Publisher="CN=84E326A0-985C-4221-9089-EF72F40C735C"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Control de Acceso Brisas</DisplayName>
    <PublisherDisplayName>DQM27</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="es-CR" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Applications>
    <Application Id="ControlAcceso" Executable="control_acceso.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Control de Acceso Brisas"
        Description="Administra empresas, contratistas, usuarios e ingresos/salidas de una instalación."
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Alias de ejecución: con la app instalada, cualquier cmd/PowerShell
             que se abra después reconoce "brisas" como comando y arranca este
             mismo ejecutable ahí mismo (no abre ventana nueva ni necesita
             editar el PATH) — Windows resuelve "brisas" a "brisas.exe" solo. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="control_acceso.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="brisas.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
