<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Normal (sin permiso en tiempo de ejecución): hace falta para
         controlar la intensidad de la vibración de confirmación/error del
         escáner con Vibrator/VibrationEffect en vez del haptic feedback
         semántico de Compose, que no deja elegir qué tan fuerte vibra. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- La base de datos local trae cédulas, hashes de contraseña e
         historial de accesos. Con allowBackup=true (el default), Android
         la incluye sin avisar en el backup automático a la cuenta de
         Google y en la transferencia de datos a un teléfono nuevo — para
         una app atada a un dispositivo específico eso es una fuga de PII
         real, no un beneficio. Si algún día hace falta backup parcial
         (ej. preferencias, no la base), usar dataExtractionRules en vez
         de reactivar esto entero. -->
    <application
        android:name=".AplicacionControlAcceso"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Lattis"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Sentry (io.sentry:sentry-android): init automático, sin
             Application/código propio. DSN del proyecto
             `control-acceso-mobile`, mismo criterio que el DSN de escritorio
             en desktop/src-tauri/src/lib.rs: no es secreto, va embebido en
             el cliente. `sentryEnvironment` viene de los
             `manifestPlaceholders` de app/build.gradle.kts
             (debug="development", release="production"). El sample rate en
             0.0: sólo error-tracking, sin performance tracing (mismo motivo
             que `traces_sample_rate = 0.0` en desktop, para no gastar cuota
             del plan gratis en algo sin usar). -->
        <meta-data android:name="io.sentry.dsn"
            android:value="https://5fb608eb8db4b9a18aca8d2901a4b894@o4512103124041728.ingest.us.sentry.io/4512104610463744" />
        <meta-data android:name="io.sentry.environment"
            android:value="${sentryEnvironment}" />
        <meta-data android:name="io.sentry.traces.sample-rate"
            android:value="0.0" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <!-- Sin esto, girar el teléfono (o forzar horizontal a mano
                 desde una pantalla puntual, ver PantallaEscanearComprobanteRuta)
                 destruye y recrea TODA la Activity: con una sola Activity
                 para toda la app, eso significa perder cualquier estado que
                 no viva en un ViewModel (ej. "¿la cámara está abierta?"),
                 devolviendo a quien opera a una pantalla anterior sin avisar
                 (hallazgo 2026-09-20: girar el celular para leer el
                 comprobante de ruta, un papel más ancho que una cédula, sacaba
                 de la cámara en vez de ayudar). Compose ya recompone solo
                 ante un cambio de configuración, no hace falta el
                 reinicio completo que sí necesitaba una Activity clásica
                 basada en XML/vistas. -->

            <!-- Sin esto, el modo por defecto de Android ("adjustPan") movía
                 TODA la ventana hacia arriba al abrir el teclado, incluida
                 la cabecera fija (botón "Nuevo contratista", pestañas) que
                 vive fuera del scroll propio de cada pantalla, en
                 PantallaPrincipal, en vez de dejar que solo el contenido
                 con `imePadding()`/scroll se reacomode (reportado 2026-09-20,
                 en Rutas y Proveedores). `adjustResize` es lo correcto acá
                 porque el teclado ya se maneja vía insets/Compose, no vía
                 redimensionado nativo de la ventana. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
