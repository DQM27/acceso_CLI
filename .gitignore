# Rust
/target/
# Vendor-lib de SQLite3MC (ver sqlite3mc-vendor-lib/build.rs): la lib estática
# compilada es artefacto de build, no fuente -- el amalgamation vendorizado sí
# se commitea.
/sqlite3mc-vendor-lib/target/
/sqlite3mc-vendor-lib/dist/

# Experimentos: cancha de pruebas, no código de producción — el que se usa de
# verdad vive integrado en el proyecto (ver desktop/src-tauri, núcleo raíz).
/experiments/

# Bases de datos locales
*.db
*.sqlite
*.sqlite3

# Variables de entorno y secretos
.env
.env.*
supabase_admin_key.txt
supabase_signing_key.json
nueva_clave_firma.json

# Datos personales reales (empleados/contratistas) que no van a git -- se
# usan localmente como insumo, el import real va a la DB, no al repo.
empleados_costa_rica.sql
contratistas_base_final_limpia_v15.sql

# Configuración local de servidores MCP -- no compartida vía git.
.mcp.json

# IDE / editores
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db

# Archivos temporales
*.tmp
*.temp

# Empaquetado MSIX: el .exe copiado y el paquete generado son artefactos de
# build, no fuente — el manifiesto y los Assets sí se commitean
packaging/msix/control_acceso.exe
packaging/msix/*.msix
*.pfx
# Cloudflare Wrangler -- cache local, incluye el ID de cuenta
.wrangler/
