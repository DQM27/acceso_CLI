// Worker de carnés PRAIND (fase 2 de docs/features-futuras/plan-fotos-praind.md).
// Sirve y recibe los carnés del bucket privado de R2. No guarda secretos:
// R2 por binding y los permisos los decide Supabase con el JWT de quien llama.
// Desplegar es manual: `npm run deploy:staging` y, después de probar, `npm run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "praind-brisas",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "praind.megabrisas.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "lattis-praind" }],
  "vars": {
    "SUPABASE_URL": "https://xidaepyaljzkpbsxrqsm.supabase.co",
    // Clave publicable (no es secreta): la misma que usa el panel.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Sr9DPGMD7MFirLQfG7ViWg_6pJeEpqU",
    // Orígenes web que pueden llamar con CORS. Las apps nativas no usan CORS.
    "ORIGENES_PERMITIDOS": "https://panel.megabrisas.com"
  },
  "env": {
    "staging": {
      "name": "praind-brisas-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "routes": [{ "pattern": "praind-staging.megabrisas.com", "custom_domain": true }],
      "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "lattis-praind-staging" }],
      "vars": {
        "SUPABASE_URL": "https://pmrytjktlyiuikxuuxpr.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_29DwMvfyj8Jq--LBcqxtBA_pTwWrDH4",
        "ORIGENES_PERMITIDOS": "http://localhost:5173"
      }
    }
  }
}
