{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattis",
  "version": "1.6.2",
  "identifier": "com.dqm27.lattis.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lattis",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 320,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://xidaepyaljzkpbsxrqsm.supabase.co wss://xidaepyaljzkpbsxrqsm.supabase.co https://pmrytjktlyiuikxuuxpr.supabase.co wss://pmrytjktlyiuikxuuxpr.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Spanish"],
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQkZBQTI5NkFEMjI1MgpSV1JTSXEyV292cmJCdjlkOU1pdTNWSFJ2ZDR6R3REVGt3VTVwTmlYNFFUWXpJYlFRR21JTEdHSgo=",
      "endpoints": [
        "https://github.com/DQM27/acceso_CLI/releases/latest/download/latest.json"
      ]
    }
  }
}
