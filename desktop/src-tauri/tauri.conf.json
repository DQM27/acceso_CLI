{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "control-acceso-desktop",
  "version": "1.5.3",
  "identifier": "com.dqm27.controlaccesobrisas.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Control de Acceso",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://xidaepyaljzkpbsxrqsm.supabase.co wss://xidaepyaljzkpbsxrqsm.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQkZBQTI5NkFEMjI1MgpSV1JTSXEyV292cmJCdjlkOU1pdTNWSFJ2ZDR6R3REVGt3VTVwTmlYNFFUWXpJYlFRR21JTEdHSgo=",
      "endpoints": [
        "https://github.com/DQM27/acceso_CLI/releases/latest/download/latest.json"
      ]
    }
  }
}
