{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visitas-brisas",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "visitas.megabrisas.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
